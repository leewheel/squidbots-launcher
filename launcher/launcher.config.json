{
  "appName": "征服艾泽拉斯 单机启动器",
  "launcherUpdateUrl": "",
  "launcherUpdateKey": "",
  "discordUrl": "",
  "trustedLocalHosts": [
    "127.0.0.1",
    "localhost"
  ],
  "game": {
    "name": "Conquest of Azeroth",
    "clientExecutable": "Ascension.exe",
    "processNames": [
      "Ascension.exe",
      "Wow.exe"
    ],
    "manifestUrl": "",
    "addonCatalogUrl": "",
    "releaseKey": "",
    "realmlists": [
      {
        "name": "本机服务器",
        "address": "127.0.0.1"
      }
    ]
  },
  "server": {
    "description": {
      "zh": "征服艾泽拉斯（COA）本机服务器：AzerothCore 核心、完整地图数据与已建好的数据库，全离线运行，由启动器统一启动、停止与备份。",
      "en": "Conquest of Azeroth local server: core, maps and a ready database, all offline, started and stopped by the launcher."
    },
    "releaseKey": "",
    "requiredExecutable": "worldserver.exe",
    "services": [
      {
        "id": "mysql",
        "name": "MySQL 数据库",
        "port": 3396,
        "cwd": ".",
        "exe": "mysql/bin/mysqld.exe",
        "args": [
          "--defaults-file={root}/my.ini",
          "--port=3396"
        ],
        "startTimeout": 960,
        "stopExe": "mysql/bin/mysqladmin.exe",
        "stopArgs": [
          "--defaults-file=mysql/admin-client.ini",
          "shutdown"
        ]
      },
      {
        "id": "world",
        "name": "世界服务器",
        "port": 8085,
        "cwd": ".",
        "exe": "worldserver.exe",
        "args": [],
        "console": true,
        "stopCommand": "server shutdown 1s 0",
        "startTimeout": 600
      },
      {
        "id": "auth",
        "name": "登录服务器",
        "port": 3724,
        "cwd": ".",
        "exe": "authserver.exe",
        "args": [],
        "startTimeout": 120
      }
    ],
    "multirace": false
  },
  "edition": "server",
  "feedUrl": "",
