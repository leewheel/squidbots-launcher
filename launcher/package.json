{
  "name": "coa-launcher-lite",
  "productName": "征服艾泽拉斯 单机启动器",
  "version": "1.0.202611121450",
  "description": "征服艾泽拉斯（Conquest of Azeroth）单机整合包启动器：一键启动/停止本地 MySQL、登录服务器与世界服务器，管理设置、备份与国度。",
  "license": "MIT",
  "author": "leewheel",
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/copy-fonts.cjs && electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "dist": "node scripts/copy-fonts.cjs && node scripts/bump-version.cjs && electron-builder --win nsis --publish never",
    "stage": "node scripts/copy-fonts.cjs && node scripts/bump-version.cjs && node scripts/stage-app.cjs",
    "dist:obf": "node scripts/copy-fonts.cjs && node scripts/bump-version.cjs && node scripts/stage-app.cjs && electron-builder --win portable --publish never && node scripts/write-launcher-release.cjs",
    "release:manifest": "node scripts/write-launcher-release.cjs",
    "release:prune": "node scripts/prune-releases.cjs"
  },
  "build": {
    "appId": "org.coa.launcher-lite",
    "productName": "征服艾泽拉斯 单机启动器",
    "artifactName": "CoA-Launcher-${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "compression": "store",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist",
      "app": "build/app"
    },
    "files": [
      "src/**",
      "public/**",
      "launcher.config.json",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "editions/server/icon.png"
    },
    "portable": {
      "unpackDirName": "CoALauncherLite-1.0.202611121450",
      "requestExecutionLevel": "user"
    },
    "publish": null
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.10.0"
  }
}
